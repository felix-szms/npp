[project]
sub_id = "59aa51d2"
name = "nuclear-power-plant-principles"
requires = ["nodejs-24"]
project_type = "web"
version = "0.1.9"
entrypoint = "server.js"

[preview]
preview_enable = "enabled"

[dev]
build = ["bash", "scripts/build.sh"]
run = ["bash", "scripts/run.sh"]

[deploy]
build = ["bash", ".cozeproj/scripts/deploy_build.sh"]
run = ["bash", ".cozeproj/scripts/deploy_run.sh"]

[deploy.profile]
kind = "service"
flavor = "web"

[deploy.backend]
enabled = true

[subprojects]
path = ["."]
